# Diamond Dental Group: static Next.js export on SiteGround (Apache).
# Does what a Node server would: canonical host, trailing slashes, redirects,
# headers, caching and compression.

Options -Indexes
DirectoryIndex index.html index.php
# The trailing slash is added by a rewrite below (on https), not by Apache.
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- One address: https://diamonddentalgroups.com (no www), like the live site. ----
  # www, the SiteGround temporary address (*.sg-host.com) and any other host
  # pointed here go to the main domain, path kept. localhost is left alone for testing.
  RewriteCond %{HTTP_HOST} !^diamonddentalgroups\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^(.*)$ https://diamonddentalgroups.com/$1 [R=301,L]
  # http -> https (also turn on SiteGround Site Tools > Security > SSL Manager > HTTPS Enforce).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP_HOST} ^diamonddentalgroups\.com$ [NC]
  RewriteRule ^(.*)$ https://diamonddentalgroups.com/$1 [R=301,L]

  # ---- Old URLs (keep above the slash rule) ----
  # The live site's pages had no trailing slash (/about, /services/invisalign);
  # the slash rule at the bottom sends each one to the same page with a slash.
  RewriteRule ^index\.html?$ https://%{HTTP_HOST}/ [R=301,L,NC]
  RewriteRule ^home/?$ https://%{HTTP_HOST}/ [R=301,L,NC]

  # WordPress leftovers. The web archive has no earlier version of this domain,
  # so no old file names are known: old uploads and ?page_id= / ?p= short links
  # go to the home page, query dropped.
  RewriteRule ^wp-content/uploads/ https://%{HTTP_HOST}/ [R=301,L,NC]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=\d+(?:&|$) [NC]
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/ [R=301,L,QSD]
  # WordPress sitemaps -> the real sitemap.
  RewriteRule ^(?:sitemap_index|wp-sitemap|[a-z_-]+-sitemap\d*|wp-sitemap-[a-z0-9_-]+)\.xml$ https://%{HTTP_HOST}/sitemap.xml [R=301,L,NC]
  # WordPress-only paths: 410 Gone, so search engines drop them.
  RewriteRule ^(?:wp-admin|wp-includes|wp-json|wp-content)(?:/|$) - [G,L,NC]
  RewriteRule ^(?:wp-login|xmlrpc|wp-cron|wp-signup|wp-trackback|wp-comments-post)\.php$ - [G,L,NC]
  RewriteRule ^(?:.+/)?(?:feed|trackback|embed)/?$ - [G,L,NC]
  RewriteRule ^(?:category|tag|author)/ - [G,L,NC]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:rest_route|feed|attachment_id)= [NC]
  RewriteRule ^(?:index\.php)?$ - [G,L]
  # ---- end of old URLs ----

  # Pages live at /page/ (page/index.html): add the missing slash, on https
  # (absolute, so visitors behind SiteGround's proxy are not bounced through http).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # The Sanity Studio is one page; its inner URLs (/cms/structure/...) load it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^cms/. /cms/index.html [L]
</IfModule>

# The form's settings file and the upload tool's file list are never served.
<FilesMatch "^(lead-config\.php|\.ftp-deploy-sync-state\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

  # CSP. Third parties allowed: Google Tag Manager / Analytics / Ads (the live
  # site's GTM container fires Google Ads), Google Maps and the Jarvis Analytics
  # scheduler (iframes), Sanity images, and the GoHighLevel (LeadConnector) chat.
  # If you add tags in GTM that load other scripts, add their domains here.
  # The studio at /cms talks to many Sanity hosts and is protected by Sanity login instead.
  <If "%{REQUEST_URI} !~ m#^/cms(/|$)#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://*.doubleclick.net https://www.google.com https://*.leadconnectorhq.com https://*.msgsndr.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://*.leadconnectorhq.com https://*.msgsndr.com https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://*.leadconnectorhq.com https://*.msgsndr.com https://fonts.gstatic.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://*.doubleclick.net https://www.googleadservices.com https://*.leadconnectorhq.com https://*.msgsndr.com wss://*.leadconnectorhq.com https://challenges.cloudflare.com; frame-src 'self' https://maps.google.com https://www.google.com https://schedule.jarvisanalytics.com https://www.googletagmanager.com https://*.doubleclick.net https://*.leadconnectorhq.com https://*.msgsndr.com https://challenges.cloudflare.com; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  </If>

  # Caching: hashed build files forever, photos for a month, pages always fresh.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Compress text files. Apache serves .js as text/javascript, so both JavaScript types are listed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>
