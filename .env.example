# Copy to .env.local for local development. The NEXT_PUBLIC_ values are read
# at build time (static export). Never commit real values.

# --- Sanity (the site shows its built-in copy until the CMS has content)
NEXT_PUBLIC_SANITY_PROJECT_ID=stnpzvwa
NEXT_PUBLIC_SANITY_DATASET=production
# Only for `npm run seed` on your machine (Editor token from sanity.io/manage > API > Tokens).
SANITY_WRITE_TOKEN=

# --- Site
NEXT_PUBLIC_SITE_URL=https://diamonddentalgroups.com

# --- GoHighLevel
# Website chat widget ID (Sites > Chat Widget > Get code: data-widget-id). Empty or "off" hides the chat.
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# --- Analytics (optional; nothing loads when empty). The live site uses GTM-M664LDQG.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
